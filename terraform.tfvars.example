# Copy to terraform.tfvars and adjust if needed.
aws_region             = "eu-central-1"
project_name           = "hello-web"
instance_type          = "t3.micro"
asg_min_size           = 2
asg_desired_capacity   = 2
asg_max_size           = 6
cloudfront_price_class = "PriceClass_All"
enable_ssm_endpoints   = false
alarm_email            = ""
